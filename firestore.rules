rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    match /rooms/{roomId} {
      // Allow reading rooms so players can find rooms by roomCode and view lobby/game status
      allow read: if true;

      // Allow creating, updating, or deleting a room only for authenticated sessions
      allow create, update, delete: if isAuthenticated();

      // Players subcollection
      match /players/{playerId} {
        allow read: if true;
        allow create, update, delete: if isAuthenticated();
      }

      // Rounds subcollection
      match /rounds/{roundId} {
        allow read: if true;
        allow create, update, delete: if isAuthenticated();

        // Submissions/Answers in this round
        match /answers/{answerId} {
          allow read: if true;
          allow create, update, delete: if isAuthenticated();
        }

        // Votes cast in this round
        match /votes/{voteId} {
          allow read: if true;
          allow create, update, delete: if isAuthenticated();
        }

        // Scores calculated for this round
        match /scores/{scoreId} {
          allow read: if true;
          allow create, update, delete: if isAuthenticated();
        }
      }
    }
  }
}
